APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Pengembangan lokal cukup memakai MySQL/MariaDB biasa.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portal_kesiswaan
DB_USERNAME=root
DB_PASSWORD=

# Produksi memakai TiDB Cloud (kompatibel MySQL).
# Isi nilai berikut di environment Vercel, jangan di file ini.
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USERNAME=<username>.root
# DB_PASSWORD=<password>
# MYSQL_ATTR_SSL_CA=database/certs/cacert.pem
#
# Catatan: bila DB_HOST bukan 127.0.0.1/localhost, aplikasi otomatis memakai
# database/certs/cacert.pem sebagai CA TLS. Variabel MYSQL_ATTR_SSL_CA hanya
# perlu diisi bila ingin memakai sertifikat lain.

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Penyimpanan gambar unggahan
# ---------------------------------------------------------------------------
# Di Vercel, variabel ini diisi otomatis saat Blob store dihubungkan ke project.
# Di lokal boleh dikosongkan agar gambar disimpan ke folder public/storage.
BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# BLOB_ACCESS=public

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
